<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.miniprojet">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"> <!-- CHANGÉ : Style AppCompat -->

        <!-- Activité de lancement -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/AppTheme"> <!-- AJOUTÉ : thème -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TOUTES les activités qui étendent AppCompatActivity DOIVENT avoir @style/AppTheme -->
        <activity
            android:name=".SignInActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".LoginActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".DashboardActivity"
            android:theme="@style/AppTheme"
            android:exported="false" />
        <activity
            android:name=".ChangePasswordActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ProfileActivity"
            android:theme="@style/AppTheme" /> <!-- ICI : ajout du thème -->
        <activity
            android:name=".EditProfileActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".CreateAnnouncesActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ViewAnnouncesActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".AllAnnouncesActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".AdvertisementDetailActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".EditAdvertisementActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".FavoritesActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".MapActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".RouteActivity"
            android:theme="@style/AppTheme" />


    </application>

</manifest>