<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_advertisement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Image de l'annonce -->
        <ImageView
            android:id="@+id/iv_ad_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image"
            android:contentDescription="Image de l'annonce" />

        <!-- Bouton favori -->
        <ImageView
            android:id="@+id/btn_favorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="Ajouter aux favoris"
            app:tint="@color/gray" />

        <!-- Contenu textuel à droite de l'image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_ad_image"
            android:layout_toStartOf="@id/btn_favorite"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <!-- Titre -->
            <TextView
                android:id="@+id/tv_ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Titre de l'annonce"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/black" />

            <!-- Adresse -->
            <TextView
                android:id="@+id/tv_ad_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Adresse, Ville"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/gray_dark" />

            <!-- Prix et Surface -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Prix -->
                <TextView
                    android:id="@+id/tv_ad_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="750 €"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <!-- Séparateur -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/gray_light" />

                <!-- Surface -->
                <TextView
                    android:id="@+id/tv_ad_surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35 m²"
                    android:textSize="14sp"
                    android:textColor="@color/gray_dark" />

            </LinearLayout>

            <!-- Pièces et Équipements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Nombre de pièces -->
                <TextView
                    android:id="@+id/tv_ad_rooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 pièces"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark" />

                <!-- Séparateur -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="•"
                    android:textSize="12sp"
                    android:textColor="@color/gray" />

                <!-- Équipements -->
                <TextView
                    android:id="@+id/tv_ad_amenities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠 🛗"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark" />

            </LinearLayout>

            <!-- Note et Distance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Note -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    android:tint="@color/warning"
                    android:contentDescription="Note" />

                <TextView
                    android:id="@+id/tv_ad_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.5"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_ad_rating_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="(24)"
                    android:textSize="12sp"
                    android:textColor="@color/gray" />

                <!-- Distance (optionnel) -->
                <TextView
                    android:id="@+id/tv_ad_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="1.2 km"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>